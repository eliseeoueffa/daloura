{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daloura",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Envoi des emails (code oublié) par MakiSend. La clé va dans les secrets : MAKISEND_API_KEY.
  "vars": { "MAKISEND_URL": "https://makisend.elisee.workers.dev" },
  // Base D1 : schéma dans migrations/ (npm run db:migrate:local / db:migrate:remote).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daloura",
      "database_id": "4d6f8eb5-bf7b-449d-9440-09593d870d2b",
      "migrations_dir": "migrations"
    }
  ],
  // Photos (selfies, inspirations) : bucket R2 privé, à créer une fois dans le tableau de bord Cloudflare.
  // Suppressions automatiques (worker/purge.ts), chaque nuit à 3 h 17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "daloura-media" }]
}
